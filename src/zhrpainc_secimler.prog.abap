  IF PNPORGEH-OPTION EQ 'EQ'.
    CONCATENATE ORGANIZASYON PNPORGEH-LOW
                INTO ORGANIZASYON SEPARATED BY SPACE.
  ELSEIF PNPORGEH-OPTION EQ 'NE'.
    CONCATENATE ORGANIZASYON PNPORGEH-LOW '-HARİCİ-'
                INTO ORGANIZASYON SEPARATED BY SPACE.
  ELSE.
    CONCATENATE ORGANIZASYON '(' PNPORGEH-OPTION ')' PNPORGEH-LOW
                INTO ORGANIZASYON SEPARATED BY SPACE.
  ENDIF.
ELSE.
  CONCATENATE ORGANIZASYON PNPORGEH-LOW '-' PNPORGEH-HIGH
              INTO ORGANIZASYON SEPARATED BY SPACE.
