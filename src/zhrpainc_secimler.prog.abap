*&---------------------------------------------------------------------*
*& Include          ZHRPAINC_SECIMLER
*&---------------------------------------------------------------------*
*----------------------------------------------------------------------*
*   INCLUDE ZHRPAINC_SECIMLER                                          *
*----------------------------------------------------------------------*
*tables: t001.
DATA : ILK_TARIH(10),
       SON_TARIH(10).
DATA : SIRKET(40)       VALUE 'Şirket :',
       DONEM(40)        VALUE 'Dönem        :',
       PERSONEL(40)     VALUE 'Personel         :',
       PERSALANI(40)    VALUE 'Personel alanı   :',
       PALTALANI(40)    VALUE 'Personel altalanı:',
       CALGRUBU(40)     VALUE 'Çalışan grubu    :',
       CALALTGRB(40)    VALUE 'Çalışan alt grubu:',
       BDRALTBIRIMI(40) VALUE 'Bordro alt birimi:',
       ORGANIZASYON(40) VALUE 'Orgnzasyon birimi:',
       USTALAN(40)      VALUE 'Üstalan(Şefalanı):'.
*** 'Şirket :' ***
IF PNPBUKRS-LOW IS INITIAL.
ELSEIF PNPBUKRS-HIGH IS INITIAL.
  SELECT * FROM T001 WHERE BUKRS = PNPBUKRS-LOW.
  ENDSELECT.
  IF PNPBUKRS-OPTION EQ 'EQ'.
    CONCATENATE SIRKET T001-BUTXT
                INTO SIRKET SEPARATED BY SPACE.
  ELSEIF PNPBUKRS-OPTION EQ 'NE'.
    CONCATENATE SIRKET T001-BUTXT '-HARİCİ-'
                INTO SIRKET SEPARATED BY SPACE.
  ELSE.
    CONCATENATE SIRKET '(' PNPBUKRS-OPTION ')' T001-BUTXT
                INTO SIRKET SEPARATED BY SPACE.
  ENDIF.
ELSE.
  CONCATENATE SIRKET PNPBUKRS-LOW '-' PNPBUKRS-HIGH
              INTO SIRKET SEPARATED BY SPACE.
ENDIF.
*** 'Dönem :' ***
WRITE PN-BEGDA TO ILK_TARIH DD/MM/YYYY.
WRITE PN-ENDDA TO SON_TARIH DD/MM/YYYY.
CONCATENATE DONEM ILK_TARIH '-' SON_TARIH
            INTO DONEM SEPARATED BY SPACE.
*** 'Personel :' ***
IF PNPPERNR-LOW IS INITIAL.
ELSEIF PNPPERNR-HIGH IS INITIAL.
  IF PNPPERNR-OPTION EQ 'EQ'.
    CONCATENATE PERSONEL PNPPERNR-LOW
                INTO PERSONEL SEPARATED BY SPACE.
  ELSEIF PNPPERNR-OPTION EQ 'NE'.
    CONCATENATE PERSONEL PNPPERNR-LOW '-HARİCİ-'
                INTO PERSONEL SEPARATED BY SPACE.
  ELSE.
    CONCATENATE PERSONEL '(' PNPPERNR-OPTION ')' PNPPERNR-LOW
                INTO PERSONEL SEPARATED BY SPACE.
  ENDIF.
ELSE.
  CONCATENATE PERSONEL PNPPERNR-LOW '-' PNPPERNR-HIGH
              INTO PERSONEL SEPARATED BY SPACE.
ENDIF.
*** 'Personel alanı :' ***
IF PNPWERKS-LOW IS INITIAL.
ELSEIF PNPWERKS-HIGH IS INITIAL.
  IF PNPWERKS-OPTION EQ 'EQ'.
    CONCATENATE PERSALANI PNPWERKS-LOW
                INTO PERSALANI SEPARATED BY SPACE.
  ELSEIF PNPWERKS-OPTION EQ 'NE'.
    CONCATENATE PERSALANI PNPWERKS-LOW '-HARİCİ-'
                INTO PERSALANI SEPARATED BY SPACE.
  ELSE.
