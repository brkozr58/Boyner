     <INITIALIZATION>
      <FPCLINE/>
      <FPCLINE>DATA : lv_table(2) TYPE n .</FPCLINE>
      <FPCLINE>DATA : ls_payroll TYPE /dsl/hr20_s012.</FPCLINE>
      <FPCLINE>DATA : ls_return TYPE /dsl/hr20_s035.</FPCLINE>
      <FPCLINE>DATA : lv_tabname(30).</FPCLINE>
      <FPCLINE/>
      <FPCLINE>FIELD-SYMBOLS : &lt;ft_table&gt; TYPE /dsl/hr20_tt012.</FPCLINE>
      <FPCLINE>FIELD-SYMBOLS : &lt;fs_sum&gt; TYPE /dsl/hr20_s012.</FPCLINE>
      <FPCLINE>FIELD-SYMBOLS : &lt;fs_table&gt; TYPE any.</FPCLINE>
      <FPCLINE>FIELD-SYMBOLS : &lt;fs_tot&gt;   TYPE ts_subtot.</FPCLINE>
      <FPCLINE>*break d_bozer.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>CLEAR :  s011    ,</FPCLINE>
      <FPCLINE>         gt_01[] ,gv_tot01,gs_01   ,</FPCLINE>
      <FPCLINE>         gt_02[] ,gv_tot02,gs_02   ,</FPCLINE>
      <FPCLINE>         gt_03[] ,gv_tot03,gs_03   ,</FPCLINE>
      <FPCLINE>         gt_04[] ,gv_tot04,gs_04   ,</FPCLINE>
      <FPCLINE>         gt_05[] ,gv_tot05,gs_05   ,</FPCLINE>
      <FPCLINE>         gt_06[] ,gv_tot06,gs_06   ,</FPCLINE>
      <FPCLINE>         gt_07[] ,gv_tot07,gs_07   ,</FPCLINE>
      <FPCLINE>         gt_08[] ,gv_tot08,gs_08   ,</FPCLINE>
      <FPCLINE>         gt_09[] ,gv_tot09,gs_09   ,</FPCLINE>
      <FPCLINE>         gt_10[] ,         gs_10   ,</FPCLINE>
      <FPCLINE>         gt_11[] ,         gs_11   ,</FPCLINE>
      <FPCLINE>         gt_12[] ,         gs_12   ,</FPCLINE>
      <FPCLINE>         gt_13[] ,         gs_13   ,</FPCLINE>
      <FPCLINE>         gt_14[] ,         gs_14   ,</FPCLINE>
      <FPCLINE>         gt_15[] ,         gs_15   ,</FPCLINE>
      <FPCLINE>         gv_adres,</FPCLINE>
      <FPCLINE>         gv_unvan,</FPCLINE>
      <FPCLINE>         gv_ndy  .</FPCLINE>
      <FPCLINE/>
      <FPCLINE>LOOP AT i_table INTO s011.</FPCLINE>
      <FPCLINE>  CLEAR : lv_table.</FPCLINE>
      <FPCLINE>  LOOP AT s011-t_payroll INTO ls_payroll</FPCLINE>
      <FPCLINE>*    WHERE lgart NE &apos;SUM&apos;</FPCLINE>
      <FPCLINE>    .</FPCLINE>
      <FPCLINE>    ON CHANGE OF ls_payroll-pytyp.</FPCLINE>
      <FPCLINE>*      ADD 1 TO lv_table .</FPCLINE>
      <FPCLINE>      lv_table = ls_payroll-pytyp.</FPCLINE>
      <FPCLINE>      lv_tabname = &apos;GT_&apos; &amp;&amp; lv_table.</FPCLINE>
      <FPCLINE>      ASSIGN (lv_tabname) TO &lt;ft_table&gt;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>      lv_tabname = &apos;GS_&apos; &amp;&amp; lv_table.</FPCLINE>
      <FPCLINE>      ASSIGN (lv_tabname) TO &lt;fs_sum&gt;.</FPCLINE>
      <FPCLINE>    ENDON.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>    CHECK &lt;ft_table&gt; IS ASSIGNED AND &lt;fs_sum&gt; IS ASSIGNED .</FPCLINE>
      <FPCLINE/>
      <FPCLINE>    IF ls_payroll-lgart NE &apos;SUM&apos;.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>      COLLECT ls_payroll INTO &lt;ft_table&gt;.</FPCLINE>
      <FPCLINE>    ELSE.</FPCLINE>
      <FPCLINE>      IF ls_payroll-seqnr EQ &apos;999&apos; AND ls_payroll-pytyp EQ &apos;004&apos; .</FPCLINE>
      <FPCLINE>        CLEAR ls_payroll-brtur.</FPCLINE>
      <FPCLINE>      ENDIF.</FPCLINE>
      <FPCLINE>      MOVE-CORRESPONDING ls_payroll TO &lt;fs_sum&gt;. &quot; Dip toplamları al</FPCLINE>
      <FPCLINE>    ENDIF.</FPCLINE>
      <FPCLINE>  ENDLOOP.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>*break d_bozer.</FPCLINE>
      <FPCLINE>  LOOP AT s011-t_total INTO ls_payroll.</FPCLINE>
      <FPCLINE>    CONCATENATE &apos;GV_TOT&apos; ls_payroll-seqnr+1(2) INTO lv_tabname.</FPCLINE>
      <FPCLINE>    ASSIGN (lv_tabname) TO &lt;fs_tot&gt;.</FPCLINE>
      <FPCLINE>    CHECK &lt;fs_tot&gt; IS ASSIGNED .</FPCLINE>
      <FPCLINE>    &lt;fs_tot&gt;-text    = ls_payroll-gtotl_t.</FPCLINE>
      <FPCLINE>    &lt;fs_tot&gt;-brtur   = ls_payroll-brtur.</FPCLINE>
      <FPCLINE>    &lt;fs_tot&gt;-netur   = ls_payroll-netur.</FPCLINE>
      <FPCLINE>    &lt;fs_tot&gt;-anzhl   = ls_payroll-anzhl.</FPCLINE>
      <FPCLINE>    UNASSIGN &lt;fs_tot&gt;.</FPCLINE>
      <FPCLINE>  ENDLOOP.</FPCLINE>
      <FPCLINE>*  break d_bozer.</FPCLINE>
      <FPCLINE>  LOOP AT s011-t_return INTO ls_return WHERE lgart EQ &apos;/NDY&apos;</FPCLINE>
      <FPCLINE>                                         AND pytab EQ &apos;RT&apos;.</FPCLINE>
      <FPCLINE>    gv_ndy = ls_return-anzhl.</FPCLINE>
      <FPCLINE>  ENDLOOP.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  CONCATENATE s011-header-st7trg01-stras</FPCLINE>
      <FPCLINE>              s011-header-st7trg01-stret</FPCLINE>
      <FPCLINE>*              s011-header-st7trg01-sdist</FPCLINE>
      <FPCLINE>      INTO gv_adres. &quot;SEPARATED BY space.</FPCLINE>
      <FPCLINE>*break d_ckalkan.</FPCLINE>
      <FPCLINE>  CONCATENATE gv_adres s011-header-st7trg01-sdist</FPCLINE>
      <FPCLINE>      INTO gv_adres SEPARATED BY space.</FPCLINE>
      <FPCLINE/>
      <FPCLINE/>
      <FPCLINE>  CONCATENATE s011-header-st7trg01-name1 s011-header-st7trg01-name2</FPCLINE>
      <FPCLINE>      INTO gv_unvan.</FPCLINE>
      <FPCLINE/>
